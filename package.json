{
  "name": "@we-the-rebel-alliance/boxd-plugin",
  "version": "0.0.0",
  "description": "Run OpenCode sessions on private boxd machines, one work per machine, and bring the transcripts and git back here",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "boxd",
    "plugin-contract"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/we-the-rebel-alliance/boxd-plugin.git"
  },
  "homepage": "https://github.com/we-the-rebel-alliance/boxd-plugin#readme",
  "bugs": {
    "url": "https://github.com/we-the-rebel-alliance/boxd-plugin/issues"
  },
  "exports": {
    "./server": "./dist/index.js"
  },
  "files": [
    "dist",
    "guest",
    "skills",
    "assets",
    "README.md",
    "NOTICE",
    "LICENSE"
  ],
  "capabilities": {
    "version": 1,
    "plugin": {
      "name": "boxd",
      "title": "boxd",
      "summary": "Parallel OpenCode sessions on private boxd machines, one work per machine; harvest brings each transcript and git back here. Load the boxd-sessions skill first. Not for a helper on this machine: use the subagent tool.",
      "vendor": {
        "id": "boxd",
        "name": "boxd",
        "domain": "boxd.sh"
      },
      "icons": [
        {
          "src": "assets/icon.svg",
          "type": "image/svg+xml"
        },
        {
          "src": "assets/icon-128.png",
          "type": "image/png"
        },
        {
          "src": "assets/icon-256.png",
          "type": "image/png"
        }
      ],
      "host": {
        "opencode": ">=2.4.1 <2.5.0",
        "tested": [
          "2.4.1"
        ]
      }
    },
    "options": {
      "type": "object",
      "properties": {
        "access": {
          "type": "string",
          "enum": [
            "all",
            "ask-changes",
            "read-only"
          ],
          "default": "all",
          "description": "How much the plugin's methods may do: every method, changes ask first, or reads only."
        },
        "allowUntestedHost": {
          "type": "boolean",
          "default": false,
          "description": "Start outside the tested OpenCode range."
        },
        "allowedRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Absolute folders here, besides the project, that work files may read or write."
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "fra",
              "nyc"
            ]
          },
          "default": [
            "fra",
            "nyc"
          ],
          "description": "The regions a new work's machine or a golden image may be placed in."
        },
        "region": {
          "type": "string",
          "enum": [
            "auto",
            "fra",
            "nyc"
          ],
          "default": "auto",
          "description": "Where a new work goes within regions; auto picks the region with the most free machines."
        },
        "keepFree": {
          "type": "object",
          "properties": {
            "fra": {
              "type": "integer",
              "minimum": 0
            },
            "nyc": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "default": {
            "fra": 0,
            "nyc": 0
          },
          "description": "Machines auto leaves free in each region for the organisation's CI pool."
        },
        "keep": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Label selectors (\"key=value\", or a bare key) for machines owned elsewhere: a match is kept, never an orphan."
        },
        "size": {
          "type": "string",
          "enum": [
            "1x4",
            "2x8",
            "4x16",
            "8x32"
          ],
          "default": "2x8",
          "description": "A new work's machine size, vCPU x GiB."
        },
        "slotsPerMachine": {
          "type": "integer",
          "minimum": 1,
          "default": 4,
          "description": "The most open works one shared machine may hold."
        },
        "git": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "email"
          ],
          "additionalProperties": false,
          "description": "The guest's git identity for every new work. Never a token."
        },
        "goldenPrefix": {
          "type": "string",
          "default": "oc-golden",
          "description": "Golden image names are <goldenPrefix>-<opencode version>-<size>."
        },
        "goldenBase": {
          "type": "string",
          "default": "stock",
          "description": "What a golden build starts from: stock, or a snapshot name in the region it lives in."
        },
        "goldenSetup": {
          "type": "string",
          "description": "An absolute path here to a script the golden builder runs before the scrub."
        },
        "warm": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "repo": {
                "type": "string"
              },
              "ref": {
                "type": "string"
              },
              "setup": {
                "type": "string"
              }
            },
            "required": [
              "repo"
            ],
            "additionalProperties": false
          },
          "default": [],
          "description": "Repositories whose checkouts, toolchains and dependencies a warm image carries, each { repo, ref?, setup? }, where setup is an absolute path here to the script that installs them; golden with repo builds one."
        },
        "buildGolden": {
          "type": "string",
          "enum": [
            "auto",
            "never"
          ],
          "default": "auto",
          "description": "Whether boxd_ensure builds a missing golden image itself, or refuses with a next step."
        },
        "notices": {
          "type": "string",
          "enum": [
            "wake",
            "queue",
            "off"
          ],
          "default": "wake",
          "description": "How a work's change reaches its session: yes, queue for when it is idle, or no notice."
        },
        "autoHibernateMinutes": {
          "type": "integer",
          "minimum": 30,
          "maximum": 1440,
          "default": 120,
          "description": "The platform's idle bound before a machine hibernates, in minutes."
        },
        "automation": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "default": "auto",
          "description": "Whether the plugin harvests and hibernates finished works itself: auto is on at access all, on is standing consent, off never."
        },
        "autoSleepMinutes": {
          "type": "integer",
          "minimum": 0,
          "default": 10,
          "description": "Idle minutes before automation harvests and hibernates a finished work; 0 turns that step off."
        },
        "orphanHours": {
          "type": "integer",
          "minimum": 1,
          "default": 12,
          "description": "A running, not-busy work no plugin call touched for this long is harvested and hibernated."
        },
        "leaseDays": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "A delete-after lease renewed on activity, in days; 0 is off."
        },
        "budget": {
          "type": "object",
          "properties": {
            "daily": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "machineHours": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "machines": {
              "type": "integer",
              "minimum": 0
            },
            "orgMachines": {
              "type": "integer",
              "minimum": 0
            },
            "action": {
              "type": "string",
              "enum": [
                "warn",
                "refuse"
              ]
            }
          },
          "required": [
            "action"
          ],
          "anyOf": [
            {
              "required": [
                "daily"
              ]
            },
            {
              "required": [
                "machineHours"
              ]
            },
            {
              "required": [
                "machines"
              ]
            },
            {
              "required": [
                "orgMachines"
              ]
            }
          ],
          "additionalProperties": false,
          "description": "Machine cost per day, machine-hours and machine caps, warned about or refused at: daily in the organisation's billing currency, machine-hours this ledger's works may run per local day, machines this ledger may hold, and the organisation's machine count."
        }
      },
      "additionalProperties": false
    },
    "methods": {
      "status": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "boxd.machine.list",
          "boxd.manage.machine-limit",
          "boxd.manage.usage",
          "boxd.env.list",
          "boxd.snapshots.list",
          "boxd.machine.exec",
          "boxd.local.ledger.read"
        ]
      },
      "events_list": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "boxd.local.ledger.read"
        ]
      },
      "job": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "boxd.machine.list",
          "boxd.machine.exec",
          "boxd.local.ledger.read"
        ]
      },
      "read": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "boxd.machine.list",
          "boxd.machine.exec"
        ]
      },
      "probe": {
        "class": "read",
        "accounts": "none"
      },
      "ensure": {
        "class": "admin",
        "accounts": "none",
        "operations": [
          "boxd.machine.new",
          "boxd.machine.get",
          "boxd.machine.list",
          "boxd.machine.label.set",
          "boxd.machine.resize",
          "boxd.machine.reboot",
          "boxd.machine.wake",
          "boxd.machine.config.set",
          "boxd.snapshots.save",
          "boxd.machine.cp",
          "boxd.machine.exec",
          "boxd.manage.machine-limit"
        ]
      },
      "submit": {
        "class": "write",
        "accounts": "none",
        "operations": [
          "boxd.machine.list",
          "boxd.machine.wake",
          "boxd.machine.cp",
          "boxd.machine.exec"
        ]
      },
      "harvest": {
        "class": "export",
        "accounts": "none",
        "operations": [
          "boxd.machine.wake",
          "boxd.machine.exec",
          "boxd.machine.cp",
          "boxd.local.session.import"
        ]
      },
      "sleep": {
        "class": "write",
        "accounts": "none",
        "operations": [
          "boxd.machine.get",
          "boxd.machine.hibernate"
        ]
      },
      "resume": {
        "class": "admin",
        "accounts": "none",
        "operations": [
          "boxd.machine.list",
          "boxd.machine.get",
          "boxd.machine.new",
          "boxd.machine.wake",
          "boxd.machine.cp",
          "boxd.machine.exec",
          "boxd.manage.machine-limit"
        ]
      },
      "reassign": {
        "class": "admin",
        "accounts": "none",
        "operations": [
          "boxd.machine.get",
          "boxd.machine.list",
          "boxd.machine.rename",
          "boxd.machine.label.set"
        ]
      },
      "golden": {
        "class": "admin",
        "accounts": "none",
        "operations": [
          "boxd.snapshots.list",
          "boxd.snapshots.save",
          "boxd.snapshots.remove",
          "boxd.machine.new",
          "boxd.machine.get",
          "boxd.machine.resize",
          "boxd.machine.reboot",
          "boxd.machine.remove",
          "boxd.machine.cp",
          "boxd.machine.exec",
          "boxd.env.list"
        ]
      },
      "exec": {
        "class": "admin",
        "accounts": "none",
        "effect": "ask",
        "operations": [
          "boxd.machine.get",
          "boxd.machine.wake",
          "boxd.machine.exec"
        ]
      },
      "drop": {
        "class": "delete",
        "accounts": "none",
        "operations": [
          "boxd.machine.get",
          "boxd.machine.list",
          "boxd.machine.exec",
          "boxd.machine.remove"
        ]
      }
    },
    "guestTools": [
      "done"
    ],
    "sources": [
      {
        "id": "boxd.works",
        "kind": "events",
        "reads": "x-boxd/work",
        "method": "events_list",
        "input": {
          "source": "works"
        },
        "service": {
          "id": "boxd.works",
          "label": "Works"
        },
        "operations": [
          "boxd.local.ledger.read"
        ],
        "cadence": {
          "suggestMinutes": 1
        },
        "signals": [
          "bus"
        ],
        "private": true,
        "cost": {
          "class": "free"
        },
        "maxBytes": 65536
      },
      {
        "id": "boxd.works.list",
        "kind": "snapshot",
        "output": "list",
        "method": "status",
        "input": {
          "list": "works"
        },
        "service": {
          "id": "boxd.works",
          "label": "Works"
        },
        "operations": [
          "boxd.local.ledger.read",
          "boxd.machine.list"
        ],
        "cost": {
          "class": "free"
        },
        "maxBytes": 65536
      }
    ],
    "actions": [],
    "events": {
      "changed": {}
    }
  },
  "scripts": {
    "bundle": "node scripts/build.mjs",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "unit": "bun test ./test/unit",
    "host": "bun test ./test/host",
    "pack": "bun test ./test/pack",
    "docs": "plugin-kit docs",
    "conformance": "plugin-kit conformance",
    "record:check": "plugin-kit record --check",
    "check": "node scripts/check.mjs",
    "test": "npm run unit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@opencode/client": "2.4.1",
    "@opencode/plugin": "2.4.1",
    "@opencode/sdk": "2.4.1",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "@we-the-rebel-alliance/plugin-contract": "github:we-the-rebel-alliance/plugin-contract#252e19fb9f7eedf3cdd37bb8ea2859fbaa162cd0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24"
  }
}

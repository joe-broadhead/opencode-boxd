{
  "name": "@joe-broadhead/opencode-boxd",
  "version": "0.1.2",
  "private": true,
  "description": "Unofficial OpenCode plugin for boxd: run a session on a private boxd machine and keep the transcript on your laptop",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "boxd"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-broadhead/opencode-boxd.git"
  },
  "homepage": "https://github.com/joe-broadhead/opencode-boxd#readme",
  "bugs": {
    "url": "https://github.com/joe-broadhead/opencode-boxd/issues"
  },
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./icon.svg": "./assets/icon.svg",
    "./icon-128.png": "./assets/icon-128.png",
    "./icon-256.png": "./assets/icon-256.png"
  },
  "files": [
    "dist",
    "guest",
    "skills",
    "assets/icon.svg",
    "assets/icon-128.png",
    "assets/icon-256.png",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "opencode": {
    "host": ">=2.2.3 <2.4.0",
    "icons": [
      {
        "src": "assets/icon.svg",
        "mimeType": "image/svg+xml",
        "sizes": [
          "any"
        ]
      },
      {
        "src": "assets/icon-128.png",
        "mimeType": "image/png",
        "sizes": [
          "128x128"
        ]
      },
      {
        "src": "assets/icon-256.png",
        "mimeType": "image/png",
        "sizes": [
          "256x256"
        ]
      }
    ],
    "vendor": {
      "id": "boxd",
      "name": "boxd",
      "domain": "boxd.sh",
      "mark": true
    }
  },
  "jelly": {
    "title": "boxd",
    "summary": "Run an OpenCode session on a private boxd machine and keep the transcript on your laptop.",
    "icon": "assets/icon.svg",
    "cost": "boxd bills each plugin machine: compute and memory while running, disk while hibernated, until boxd_drop. boxd_golden and boxd_ensure may make a short-lived builder. At access Allowed, finished works are harvested and hibernated after 10 idle minutes by default; else only with automation \"on\".",
    "tools": [
      {
        "name": "boxd.status",
        "permission": "boxd_status",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "boxd.job",
        "permission": "boxd_job",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "boxd.read",
        "permission": "boxd_read",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "boxd.ensure",
        "permission": "boxd_ensure",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "boxd.submit",
        "permission": "boxd_submit",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "boxd.harvest",
        "permission": "boxd_harvest",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "boxd.sleep",
        "permission": "boxd_sleep",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "boxd.resume",
        "permission": "boxd_resume",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "boxd.reassign",
        "permission": "boxd_reassign",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "boxd.golden",
        "permission": "boxd_golden",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "boxd.exec",
        "permission": "boxd_exec",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "boxd.drop",
        "permission": "boxd_drop",
        "effect": "allow",
        "readOnly": false
      }
    ],
    "skills": [
      "boxd"
    ],
    "rpc": [],
    "views": [],
    "signIns": [],
    "contributes": {
      "homeFeeds": [],
      "homeWidgets": [],
      "workKinds": [],
      "settings": [
        {
          "key": "access",
          "label": "Access",
          "type": "string",
          "description": "How much the plugin's tools may do. Generates default rules for agents with a base allow rule.",
          "choices": [
            {
              "value": "all",
              "label": "Allowed",
              "description": "Every tool runs without asking, reads and changes alike."
            },
            {
              "value": "ask-changes",
              "label": "Ask before changes",
              "description": "Reads run without asking. Each change asks you first."
            },
            {
              "value": "read-only",
              "label": "Read only",
              "description": "Reads run. Changes never run."
            }
          ],
          "default": "all"
        }
      ]
    }
  },
  "sources": {
    "contractVersion": 1,
    "rpc": "boxd.machines.tools",
    "probe": {
      "action": "boxd_probe"
    },
    "items": [
      {
        "id": "boxd.works",
        "kind": "events",
        "reads": "x-boxd/work",
        "tool": "events_list",
        "input": {
          "source": "works"
        },
        "accounts": {
          "named": false
        },
        "permission": {
          "events": "boxd_events_list",
          "rules": [
            {
              "action": "boxd_events_list",
              "resource": "*"
            }
          ]
        },
        "private": true,
        "cost": {
          "class": "free"
        },
        "maxBytes": 65536
      },
      {
        "id": "boxd.works.list",
        "kind": "snapshot",
        "tool": "boxd_status",
        "input": {
          "source": "works",
          "list": "works"
        },
        "output": "list",
        "accounts": {
          "named": false
        },
        "permission": {
          "tool": "boxd_status",
          "rules": [
            {
              "action": "boxd_status",
              "resource": "*"
            }
          ]
        },
        "private": true,
        "cost": {
          "class": "free"
        },
        "maxAgeSec": 900,
        "maxBytes": 65536
      }
    ]
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "typecheck": "node scripts/check.mjs typecheck",
    "build": "node scripts/check.mjs build",
    "test": "node scripts/check.mjs unit",
    "test:host": "node scripts/check.mjs host",
    "test:pack": "node scripts/check.mjs pack",
    "lint": "node scripts/check.mjs forbidden",
    "capture": "node scripts/capture-tools.mjs",
    "conformance": "bun scripts/conformance.ts"
  },
  "devDependencies": {
    "@opencode/client": "2.2.3",
    "@opencode/plugin": "2.2.3",
    "@opencode/sdk": "2.2.3",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "@we-the-rebel-alliance/source-contract": "github:we-the-rebel-alliance/source-contract#v0.3.0",
    "esbuild": "0.28.2",
    "solid-js": "1.9.17",
    "typescript": "5.9.3"
  }
}

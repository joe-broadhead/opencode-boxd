{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "vcs": {
    "enabled": false
  },
  "files": {
    "includes": ["**", "!!**/node_modules", "!!**/dist", "!!**/release", "!!**/package-lock.json", "!!**/*.tgz"]
  },
  "formatter": {
    "enabled": false
  },
